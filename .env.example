# 初始优先监控；设为 ALL 可启用 design.md 中的全部 9 个白名单标的
ASSETS=MU,SKHY,SNDK,INTC,MSTR
QUANTITIES=1,2,5
DB_PATH=./data/monitor.sqlite
MONITOR_INTERVAL_MS=60000
# QUOTE_ONLY：只做公开行情参考价差；EXECUTABLE：参考达标后再做 RFQ/深度复核
ALERT_MODE=QUOTE_ONLY

# design.md 的 MVP 风控阈值
MIN_GROSS_SPREAD_BPS=30
MIN_NET_SPREAD_BPS=60
MIN_PROFIT_USDC=5
MAX_JUPITER_PRICE_IMPACT_BPS=30
MAX_QUOTE_AGE_MS=800
REBALANCE_COST_USDC=0.50
FAILURE_BUFFER_USDC=0.50
NETWORK_COST_USDC=0.02

# Jupiter Swap API V2。API Key 可选，但生产建议配置。
JUPITER_API_KEY=
JUPITER_TAKER=
JUPITER_SLIPPAGE_BPS=30
# Keyless 限速为 0.5 RPS；免费 Key 通常为 1 RPS。付费套餐可自行调低。
JUPITER_MIN_REQUEST_INTERVAL_MS=1050

# 仅控制第二阶段可执行性复核；第一阶段始终为订单簿→Venue ticker→External ticker
# auto: 有密钥先 RFQ，失败后尝试现货深度；rfq: 只用 RFQ；depth: 只用订单簿
BACKPACK_QUOTE_MODE=auto
BACKPACK_API_KEY=
BACKPACK_API_SECRET=
BACKPACK_RFQ_POLL_MS=75
BACKPACK_RFQ_TIMEOUT_MS=1500

# 提醒：未配置 Telegram 时仍会输出到控制台并写入 SQLite
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_COOLDOWN_MS=300000
ALERT_ON_SOURCE_ERROR=true

# live monitor 也可开启纸面成交；simulate 命令始终开启
PAPER_TRADING_ENABLED=false
PAPER_MAX_LOSS_USDC=10
